#!/usr/bin/env bash
# Pain Cave Analysis — a song with the coach's voice taken out where the coach talks (Demucs htdemucs_ft vocals), for Studio
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec uv run --project "$PROJECT_DIR" --group reference python "$PROJECT_DIR/src/remove_voice.py" "$@"
