#!/usr/bin/env bash
# Pain Cave Analysis — a class recording split into its music and its coach (Demucs htdemucs_ft vocals where the coach talks), for Studio
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec uv run --project "$PROJECT_DIR" --group reference python "$PROJECT_DIR/src/separate_coach.py" "$@"
